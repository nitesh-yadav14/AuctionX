# --- Server ---
PORT=3000
NODE_ENV=development
# Frontend URL allowed by CORS (no trailing slash)
ORIGIN=http://localhost:5173

# --- Database ---
MONGO_URL=mongodb://127.0.0.1:27017/auctionx

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Production only, e.g. .yourdomain.com (leave empty for local dev)
COOKIE_DOMAIN=

# --- Cloudinary (required to upload auction images) ---
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
CLOUDINARY_URL=<cloudinary-url>

# --- Resend (optional: only the Contact form needs these) ---
RESEND_API_KEY=
CONTACT_EMAIL=
RESEND_FROM_EMAIL=AuctionX <noreply@your-verified-domain.com>
